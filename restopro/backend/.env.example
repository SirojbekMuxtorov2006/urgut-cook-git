# Lokal ishga tushirish (docker'siz) uchun. Docker'da infra/.env ishlatiladi.
DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=1
SECRET_KEY=dev-insecure-change-me
DATABASE_URL=postgres://restopro:restopro@localhost:5432/restopro
# Redis bo'lmasa USE_REDIS=0 qoldiring (kesh va kanal xotirada ishlaydi)
USE_REDIS=0
REDIS_URL=redis://localhost:6379/0
SMS_PROVIDER=console
