# ===== RestoPro — docker compose sozlamalari =====
# Nusxa oling: cp .env.example .env  va qiymatlarni o'zgartiring.

DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-characters-long
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000
# Lokal sinov uchun 0; HTTPS bilan productionda 1
SECURE_SSL_REDIRECT=0

POSTGRES_DB=restopro
POSTGRES_USER=restopro
POSTGRES_PASSWORD=restopro-strong-password
DATABASE_URL=postgres://restopro:restopro-strong-password@db:5432/restopro

REDIS_URL=redis://redis:6379/0
USE_REDIS=1

# MinIO (S3) — taom rasmlari
S3_BUCKET=restopro-media
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=restopro
S3_SECRET_KEY=restopro-minio-secret
S3_PUBLIC_DOMAIN=localhost/media-s3/restopro-media
MINIO_ROOT_USER=restopro
MINIO_ROOT_PASSWORD=restopro-minio-secret

# SMS: console (ishlab chiqish, kod loglarda chiqadi) | eskiz
SMS_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# Offline litsenziya imzosi (base64, 32 bayt). Yaratish:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
LICENSE_SIGNING_SEED=

SENTRY_DSN=
# Brauzer API'ga nginx orqali murojaat qiladi
NEXT_PUBLIC_API_URL=http://localhost
