# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oshxona_pos?schema=public"

# Auth & Security
JWT_SECRET="oshxona-pos-super-secret-jwt-key-2026-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="oshxona-pos-super-refresh-secret-jwt-key-2026"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV="development"
DEVICE_ID="DEV-MAIN-POS-01"
BRANCH_ID="019349c2-5500-7000-8000-000000000001"

# Cloud Sync (Local Server -> Cloud)
CLOUD_API_URL="http://localhost:5000/api"
CLOUD_API_KEY="oshxona-pos-cloud-api-sync-key"
SYNC_INTERVAL_MS=15000
