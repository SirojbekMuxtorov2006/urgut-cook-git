{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "restopro/backend/.venv/bin/python",
      "runtimeArgs": [
        "restopro/backend/manage.py",
        "runserver",
        "0.0.0.0:8000"
      ],
      "port": 8000
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "restopro/web/apps/dashboard",
        "exec",
        "next",
        "dev",
        "-p",
        "3100"
      ],
      "port": 3100
    }
  ]
}